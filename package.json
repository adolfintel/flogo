{
  "name": "flogo",
  "private": true,
  "version": "1.3.0",
  "description": "Create and run programs using flow charts ",
  "author": "Federico Dossena",
  "license": "AGPL-3.0-or-later",
  "main": "electron/main.js",
  "asar": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "vite --mode electron",
    "electron:build": "vite build --mode electron && electron-builder",
    "electron:build-win-x64": "vite build --mode electron && electron-builder --win --x64 --dir",
    "electron:build-win-arm64": "vite build --mode electron && electron-builder --win --arm64 --dir",
    "electron:build-linux-x64": "vite build --mode electron && electron-builder --linux --x64 --dir",
    "electron:build-linux-arm64": "vite build --mode electron && electron-builder --linux --arm64 --dir",
    "electron:build-linux-x64-appimage": "vite build --mode electron && electron-builder --linux AppImage --x64",
    "electron:build-linux-arm64-appimage": "vite build --mode electron && electron-builder --linux AppImage --arm64",
    "electron:build-mac-arm": "vite build --mode electron && electron-builder --mac --arm64 --dir",
    "electron:build-mac-intel": "vite build --mode electron && electron-builder --mac --x64 --dir",
    "electron:build-mac-arm-dmg": "vite build --mode electron && electron-builder --mac --arm64",
    "electron:build-mac-intel-dmg": "vite build --mode electron && electron-builder --mac --x64"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "@material-design-icons/font": "^0.14.15",
    "electron-context-menu": "^4.1.1",
    "electron-store": "^11.0.2",
    "jsep": "^1.4.0",
    "konva": "^10.2.0",
    "svgcanvas": "^2.6.0",
    "unplugin-info": "^1.2.4"
  },
  "build": {
    "appId": "com.fdossena.flogo",
    "productName": "Flogo",
    "files": [
      {
        "from": "dist",
        "to": "."
      },
      {
        "from": "electron",
        "to": "electron",
        "filter": "!icons"
      },
      "!release",
      "!windows-installer",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "electron/icons/",
        "to": "icons/",
        "filter": "**/*"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "electron/icons/winicon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "icon": "electron/icons/icon.png",
      "mimeTypes": [
        "application/x-flogo"
      ],
      "fileAssociations": [
        {
          "ext": "flogo",
          "name": "Flogo Program",
          "icon": "electron/icons/icon_file.png",
          "mimeType": "application/x-flogo"
        }
      ]
    },
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "./node_modules/app-builder-lib/templates/entitlements.mac.plist",
      "category": "public.app-category.education",
      "target": "dmg",
      "icon": "electron/icons/macicon.icns",
      "extendInfo": {},
      "fileAssociations": [
        {
          "ext": "flogo",
          "name": "Flogo Program",
          "icon": "electron/icons/macicon_file.icns",
          "role": "Editor"
        }
      ]
    },
    "dmg": {
      "icon": "electron/icons/macicon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
